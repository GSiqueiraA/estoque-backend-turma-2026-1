{
  "name": "estoque-backend-turma-2026-1",
  "version": "1.0.0",
  "description": "Backend do Sistema de Controle de Estoque",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:all": "concurrently -n backend,frontend -c blue,green \"npm run dev\" \"npm run dev --prefix frontend\"",
    "dev:backend": "tsx src/index.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "tsc -p tsconfig.build.json",
    "build:all": "npm run build && npm run build --prefix frontend",
    "start": "tsx dist/index.js",
    "test": "jest --coverage --runInBand",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "cucumber": "npm run cucumber --prefix frontend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viniciusbarc/estoque-backend-turma-2026-1.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/viniciusbarc/estoque-backend-turma-2026-1/issues"
  },
  "homepage": "https://github.com/viniciusbarc/estoque-backend-turma-2026-1#readme",
  "devDependencies": {
    "concurrently": "^9.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/readline-sync": "^1.4.8",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "ts-jest": "^29.4.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.8.5",
    "readline-sync": "^1.4.10"
  }
}
